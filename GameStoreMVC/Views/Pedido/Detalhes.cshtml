@model PedidoViewModel
@{
    ViewData["Title"] = "Pedido " + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ClienteViewModel cliente = ViewBag.Cliente;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedido nº @Model.Id</h2>
    <a href="/pedido/index" class="btn btn-light">Voltar</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">Dados do pedido</div>
            <div class="card-body">
                <p><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Total:</strong> @Model.ValorTotal.ToString("C")</p>
                <label class="form-label fw-bold">Status</label>
                <div class="input-group">
                    <select id="statusPedido" class="form-select" asp-items="ViewBag.ListaStatus"></select>
                    <button class="btn btn-primary" onclick="alterarStatusPedido(@Model.Id)">Alterar</button>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Cliente</div>
            <div class="card-body">
                <p class="mb-1"><strong>@cliente.Nome</strong></p>
                <p class="mb-1">@cliente.Email - @cliente.Telefone</p>
                <p class="mb-1">CPF: @cliente.Cpf</p>
                <p class="mb-0">@cliente.Logradouro, @cliente.Numero - @cliente.Bairro<br />@cliente.Cidade/@cliente.Uf - CEP @cliente.Cep</p>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Itens do pedido</div>
            <div class="card-body p-0">
                <partial name="_ItensPedido" model="Model" />
            </div>
        </div>
    </div>
</div>
