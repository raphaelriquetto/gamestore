<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Administração") - GameStore Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", false)
</head>
<body class="area-admin">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand logo" asp-controller="Admin" asp-action="Index">🎮 Game<span>Store</span> <small class="badge bg-secondary">Admin</small></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuAdmin">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuAdmin">
                <ul class="navbar-nav me-auto">
                    @if (ViewBag.Logado == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Início</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Cadastros</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Jogo" asp-action="Index">Jogos</a></li>
                                <li><a class="dropdown-item" asp-controller="Categoria" asp-action="Index">Categorias</a></li>
                                <li><a class="dropdown-item" asp-controller="Plataforma" asp-action="Index">Plataformas</a></li>
                                <li><a class="dropdown-item" asp-controller="Cliente" asp-action="Index">Clientes</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Pedido" asp-action="Index">Pedidos</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Consultas</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Pedido" asp-action="ConsultaPedidos">Consulta de pedidos</a></li>
                                <li><a class="dropdown-item" asp-controller="Pedido" asp-action="ConsultaVendas">Consulta de jogos vendidos</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="/swagger" target="_blank">APIs (Swagger)</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Ver loja</a></li>
                    @if (ViewBag.Logado == true)
                    {
                        <li class="nav-item"><span class="nav-link text-light">@Context.Session.GetString("NomeAdmin")</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Login" asp-action="LogOff">Sair</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        <partial name="_Mensagens" />
        @RenderBody()
    </main>

    <div id="toast" class="toast-loja"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
