@model List<JogoViewModel>

@if (Model.Count == 0)
{
    <p class="text-center text-light opacity-75 py-5">Nenhum jogo encontrado com esses filtros.</p>
}
<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var jogo in Model)
    {
        <div class="col">
            <div class="card card-jogo h-100">
                <a href="/home/Detalhes?id=@jogo.Id">
                    <img src="@jogo.ImagemSrc" class="card-img-top" alt="@jogo.Nome" />
                </a>
                <div class="card-body d-flex flex-column">
                    <small class="text-muted">@jogo.NomePlataforma · @jogo.NomeCategoria</small>
                    <a href="/home/Detalhes?id=@jogo.Id" class="titulo-jogo">@jogo.Nome</a>
                    <div class="mt-auto">
                        <div class="preco">@(jogo.Preco == 0 ? "Grátis" : jogo.Preco.ToString("C"))</div>
                        @if (jogo.Estoque > 0)
                        {
                            <button class="btn btn-warning btn-sm w-100" onclick="adicionarCarrinho(@jogo.Id, 1, true)">Adicionar ao carrinho</button>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm w-100" disabled>Esgotado</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
