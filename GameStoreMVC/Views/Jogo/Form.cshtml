@model JogoViewModel
@{
    ViewData["Title"] = "Cadastro de jogo";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Cadastro de Jogo</h2>

<form asp-action="Save" method="post" enctype="multipart/form-data" class="card card-body shadow-sm">
    <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />
    <div class="row g-3">
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="Id" class="form-label">Código</label>
                    @if (ViewBag.Operacao == "I")
                    {
                        <input asp-for="Id" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="Id" class="form-control" readonly />
                    }
                    <span asp-validation-for="Id" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label for="Nome" class="form-label">Nome do jogo</label>
                    <input asp-for="Nome" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
                <div class="col-md-6">
                    <label for="CategoriaId" class="form-label">Categoria</label>
                    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select"></select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="PlataformaId" class="form-label">Plataforma</label>
                    <select asp-for="PlataformaId" asp-items="ViewBag.Plataformas" class="form-select"></select>
                    <span asp-validation-for="PlataformaId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label for="Preco" class="form-label">Preço (R$)</label>
                    <input type="text" name="Preco" value="@Model.Preco.ToString("0.00")" class="form-control" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label for="Estoque" class="form-label">Estoque</label>
                    <input asp-for="Estoque" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Estoque" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label for="DataLancamento" class="form-label">Data de lançamento</label>
                    <input type="date" name="DataLancamento" value="@Model.DataLancamento.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="DataLancamento" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="col-md-4 text-center">
            <label class="form-label d-block">Imagem da capa</label>
            <img id="imgPreview" src="@Model.ImagemSrc" class="img-fluid rounded shadow-sm mb-2 preview-capa" />
            <input type="file" name="Imagem" id="Imagem" accept="image/*" onchange="exibirImagem()" class="form-control">
            <span asp-validation-for="Imagem" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <input type="submit" value="Salvar dados" class="btn btn-success" />
        <a href="/jogo/index" class="btn btn-light">Voltar</a>
    </div>
</form>
